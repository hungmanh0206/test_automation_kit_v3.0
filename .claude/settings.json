{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/qa/hooks/inject_context.js",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/qa/hooks/guard_db_access.js",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/qa/hooks/gate_on_write.js",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
